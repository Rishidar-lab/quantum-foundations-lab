# Python
.venv/
.venv_check/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Qiskit / IBM Quantum credentials & local state
.qiskit/
qiskit-ibm.json
*qiskit*ibm*.json

# Secrets / credentials / tokens (never commit)
.env
*.env
.env.*
*.key
*.pem
*secret*
*token*
*credential*
ibm_quantum_token*

# IBM job artifacts + hardware records written by jobs/*.py
jobs/*.json
!jobs/.gitkeep

# generated experiment output (regenerate with `make experiments`)
experiments/results/*
!experiments/results/.gitkeep

# learning-interface progress (per-user)
.lessons_progress.json

# images (except committed docs assets)
*.png
!docs/**/*.png
